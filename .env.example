# ---------------------------------------------------------------------------
# Frontend (Vite). Copy this file to .env.local and fill in the two values.
# Both are safe to ship to the browser. Find them in the Supabase dashboard
# under Project Settings > API. The "anon" key and the newer "publishable"
# key both work here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Edge Function secrets. These are NOT read by Vite and must never be put in
# a VITE_ variable. Set them on Supabase (see SETUP.md step 5):
#   supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL is optional. Check https://aistudio.google.com/docs/models and
# https://aistudio.google.com/docs/pricing for the current free-tier Flash model.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
